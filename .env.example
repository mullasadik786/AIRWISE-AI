# GEMINI_API_KEY: Required for server-side AI Family Assistant responses.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (used for restrictive CORS & origin checks).
APP_URL="http://localhost:3000"

# PORT: Server port (defaults to 3000).
PORT=3000
